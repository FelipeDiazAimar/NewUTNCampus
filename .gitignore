# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw Moodle/legacy-campus page dumps used as scraping fixtures — contain real
# session keys, user IDs, names and legacy-domain links (see e.g. sourcefiles/cursos.html).
*.har
harfiles/
sourcefiles/

# Tesseract.js language data (downloaded on demand, not a build artifact)
*.traineddata

# Claude Code conversation history (may contain secrets pasted in chat)
.waylog/

# generated at build time (scripts/generate-precache-manifest.mjs)
/public/precache-manifest.json
/public/pdf.worker.min.mjs

# captcha remoto (local)
scripts/captcha-remoto/.perfil-chromium/
scripts/captcha-remoto/debug/
