# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw Moodle/legacy-campus page dumps used as scraping fixtures — contain real
# session keys, user IDs, names and legacy-domain links (see e.g. sourcefiles/cursos.html).
*.har
harfiles/
sourcefiles/

# Tesseract.js language data (downloaded on demand, not a build artifact)
*.traineddata

# Claude Code conversation history (may contain secrets pasted in chat)
.waylog/

# generated at build time (scripts/generate-precache-manifest.mjs)
/public/precache-manifest.json
/public/pdf.worker.min.mjs

# captcha remoto (local): binarios descargados + secretos/config generados
scripts/captcha-remoto/.perfil-chromium/
scripts/captcha-remoto/debug/
scripts/captcha-remoto/bin/
scripts/captcha-remoto/worker-token.txt
scripts/captcha-remoto/heartbeat-secret.txt
scripts/captcha-remoto/app-url.txt

# proxy casero (binarios descargados + credenciales generadas)
scripts/proxy-casero/bin/
scripts/proxy-casero/credentials.txt

# asistencia daemon (local): config/secretos generados
scripts/asistencia-daemon/app-url.txt
scripts/asistencia-daemon/secret.txt
# el daemon ya no usa cuenta-bot, pero si quedó un credenciales.txt local con un
# DNI en texto plano, que nunca sea commiteable:
scripts/asistencia-daemon/credenciales.txt
